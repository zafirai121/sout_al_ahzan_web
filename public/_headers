# Cloudflare Pages response headers (copied to out/ by next build).
# Files under /_next/static have a content hash in their name, so a new
# deploy always uses new URLs and they can be cached for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Every page: HTTPS only from now on (a year), never shown inside a frame (a
# page dressed over it to trick a click; the site frames none of its own
# either), the file types as sent, and no camera, microphone, location or
# payment for anything on the site. (tests: scripts/site/security_headers.test.mjs)
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
